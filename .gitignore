```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.min.js
*.bundle.js

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Coverage reports
coverage/
htmlcov/
*.coverage

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Distribution / packaging
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log

# Testing
.junit-cache/
.mypy_cache/
.pytest_cache/

# OS generated files
.DS_Store
Thumbs.db

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled binary files
*.exe
*.dll
*.so
*.dylib

# Compressed archives
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.7z
*.rar
```