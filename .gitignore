```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.min.js
*.min.css
bundle.js

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Coverage reports
coverage/
htmlcov/
.coverage

# OS generated files
.DS_Store
Thumbs.db

# Testing
*.test.js
*.spec.js
.test.ts
.spec.ts

# Compression artifacts
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.rar
*.7z

# Browsers
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Distribution / packaging
*.tar
*.dmg
*.pkg
*.msi

# System files
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
```