```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
build/
*.min.js
*.bundle.js

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Coverage
coverage/
htmlcov/
*.coverage

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# Testing
.nyc_output/
coverage/
junit.xml
```